# =============================================================================
# .env.example — Copia este archivo como ".env" y rellena los valores.
# NUNCA commitees el archivo ".env" real al repositorio.
# =============================================================================

# --- Base de datos (PostgreSQL) -----------------------------------------------
# Nombre de la base de datos que Postgres creará al iniciar
POSTGRES_DB=bookmenow_dev

# Usuario de Postgres (solo para desarrollo local)
POSTGRES_USER=

# Contraseña de Postgres — usa una cadena aleatoria segura
# Puedes generar una con: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Backend (NestJS) ---------------------------------------------------------
# Puerto en el que el backend escucha dentro y fuera del contenedor
BACKEND_PORT=3000

# Secreto para firmar los JWT — debe ser largo y aleatorio
# Puedes generar uno con: openssl rand -base64 48
JWT_SECRET=

# Secreto para las sesiones HTTP
SESSION_SECRET=

# Orígenes permitidos por CORS (separados por comas, sin espacios)
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:8081,http://localhost:19000,http://localhost:19002,http://localhost:3002

# --- Frontend (Expo / React Native) -------------------------------------------
# URL pública del backend a la que el frontend se conecta
EXPO_PUBLIC_API_URL=http://localhost:3000

# Puerto del servidor web de Expo
FRONTEND_PORT=3001
