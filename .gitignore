# Global ignores for project root

# Node & package managers
node_modules/
*.log
npm-debug.log*
yarn.lock
pnpm-lock.yaml

# Build artifacts
.next/
dist/
out/
.vercel/

# Environment files
.env
.env.*
!.env.example

# Coverage / tests
coverage/
.vitest/

# Prisma local files
prisma/*.db
prisma/*.log

# OS & editor
.DS_Store
Thumbs.db
.vscode/

# Old backend folder (temporary, can be removed manually)
backend-nestjs/

# Generated artifacts and temp files
inventory.txt
strings_dump.json
skills-lock.json

# Claude Code runtime directories (skills cache, project memory)
.claude/
