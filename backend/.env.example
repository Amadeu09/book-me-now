# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bookmenow?schema=public"

# JWT
# Generate a secure secret with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
# MUST be at least 32 characters! This is a CRITICAL security setting.
JWT_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_64_CHARACTERS_LONG"
JWT_EXPIRES_IN="7d"

# Application
NODE_ENV="development"
PORT=3000

# CORS
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:19000,http://localhost:8081"

# Resend (email transaccional)
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="reservas@bookmenow.org"

# Redis (BullMQ jobs)
REDIS_HOST="localhost"
REDIS_PORT=6379
# REDIS_PASSWORD=""   # required in production (Upstash / Render Redis)

# Cloudinary (image uploads — profile photos, service images, company banners)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
