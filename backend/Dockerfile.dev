# Backend development Dockerfile for NestJS with Prisma
FROM node:20-alpine

WORKDIR /app

# Install OS deps (wget for healthcheck)
RUN apk add --no-cache openssl bash wget

# Install deps
COPY package*.json ./
COPY prisma ./prisma/
RUN npm ci && npx prisma generate

# Copy source
COPY . .

EXPOSE 3000

# Run migrations and start dev server
CMD ["sh", "-c", "npx prisma generate && npx prisma migrate deploy && npm run start:dev"]